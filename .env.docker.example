# ==========================================
# Konfigurasi Lingkungan Docker (Production)
# KJPP HJA'R CMS & Company Profile
# ==========================================

# Port & Host
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Base URL publik (ganti dengan domain asli jika sudah live, misal: https://kjpphjar.com)
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# MongoDB URI (service container "mongodb" pada internal network docker)
# Gunakan ?replicaSet=rs0 untuk mendukung transaksi Mongoose / backup restore CMS
MONGODB_URI=mongodb://mongodb:27017/kjpphjar?replicaSet=rs0

# Direktori Upload Media (harus path absolut di dalam container)
UPLOADS_DIR=/app/uploads

# Kunci Keamanan JWT & Analitik (minimal 32 karakter unik)
# Tip: buat dengan command `openssl rand -hex 32`
JWT_SECRET=ganti-dengan-string-rahasia-minimal-32-karakter-acak
JWT_EXPIRES_IN=7d
ANALYTICS_HASH_SECRET=ganti-dengan-hash-secret-minimal-32-karakter

# Bootstrap Akun Administrator Pertama
# Catatan: Akun hanya otomatis dibuat jika database masih kosong.
# Password wajib minimal 12 karakter.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GantiPasswordKuatMin12Karakter!

# Seed Data Demo Awal (true jika ingin mengisi layanan, cabang, dan pimpinan default)
SEED_DEMO_DATA=false

# Konfigurasi Reverse Proxy (jika menggunakan Nginx / Cloudflare / Traefik di depan)
TRUST_PROXY=true

# Kontak & Layanan Publik
WHATSAPP_NUMBER=628117101066

# Konfigurasi SMTP Email (opsional, untuk formulir kontak)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_TO=
